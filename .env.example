# Copy this file to .env and fill in your values. Never commit .env.

# Hugging Face token: https://huggingface.co/settings/tokens
# (a "Read" token with "Make calls to Inference Providers" permission is enough)
HF_TOKEN=your_token_here

# Which LLM backend Alfred uses:
#   hf     = Hugging Face Inference Providers (default, needs HF credits)
#   ollama = local model via Ollama (free, needs `ollama pull qwen2.5-coder:7b`)
ALFRED_BACKEND=hf

# Optional: override the model for the chosen backend
# ALFRED_MODEL_ID=Qwen/Qwen3-Coder-30B-A3B-Instruct
# OLLAMA_BASE_URL=http://localhost:11434/v1
